#include <bits/stdc++.h>
using namespace std;
long long MOD = 1e9+7;
 
long long bipower(long long a, long long b){
    long long res = 1;
    while(b>0){
        if(b&1)res = (res*a)%MOD;
        a = (a*a)%MOD;
        b >>= 1;
    }
    
    return res;
}
int main() {
	int n;
	cin>>n;
	long long ans = bipower(2, n);
	cout<<ans<<"\n";
 return 0;
}
