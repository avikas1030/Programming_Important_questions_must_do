#include <bits/stdc++.h>
using namespace std;

int main() {
	string s;
	cin>>s;
	int count = 1;
	int maxFrequency = 1;
	for(int i=1; i<s.size(); i++){
	    if(s[i]==s[i-1]){
	        count++;
	    }
	    else{
	        count = 1;
	    }
	    maxFrequency = max(maxFrequency, count);
	}
	cout<<maxFrequency<<"\n";
	return 0;
}
